rules_version = '2';

// Reglas de seguridad de Keki Keki.
// - usuarios: cada persona lee su perfil y solo cambia nombre, teléfono y
//   favoritos. El rol "admin" solo se asigna desde la consola de Firebase.
// - productos: cualquier usuario con sesión los lee; solo el admin escribe
//   (crear, editar, activar, borrar y ajustar stock).
// - pedidos: el cliente crea y lee solo los suyos; solo el admin cambia el
//   estado y registra pedidos manuales.
// - conversaciones: el cliente registra y cierra las suyas con el asistente;
//   el admin las lee todas para el panel IA.
// - config/asistente: ajustes del asistente; todos los leen, solo el admin
//   los cambia.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.rol == 'cliente';
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nombre', 'telefono', 'favoritos']);
      allow delete: if false;
    }

    match /productos/{productId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /pedidos/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.clienteId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.clienteId == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.origen in ['catalogo', 'ia', 'manual']
        && (request.resource.data.origen != 'manual' || isAdmin())
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.creado == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'actualizado', 'historial'])
        && request.resource.data.estado in
             ['pendiente', 'en_preparacion', 'listo', 'entregado', 'cancelado'];

      allow delete: if false;
    }

    match /conversaciones/{conversationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.clienteId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.clienteId == request.auth.uid
        && request.resource.data.resultado == 'en_chat'
        && request.resource.data.creado == request.time;

      // El cliente solo cambia el resultado, el pedido y el producto
      // recomendado; no puede reasignar la conversación a otra persona.
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.clienteId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['resultado', 'pedidoId', 'productoId',
                         'productoNombre', 'precio', 'actualizado'])
          && request.resource.data.resultado in
               ['en_chat', 'compro', 'sin_compra']);

      allow delete: if false;
    }

    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
